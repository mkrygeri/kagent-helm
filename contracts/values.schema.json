{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kagent Helm Chart Values",
  "description": "Configuration values for deploying Kentik Universal Agent (kagent) via Helm",
  "type": "object",
  "required": ["kagent"],
  "properties": {
    "deploymentType": {
      "type": "string",
      "enum": ["statefulset", "daemonset"],
      "default": "statefulset",
      "description": "Kubernetes workload type for agent deployment. Use openshift.enabled=true for OpenShift-specific rendering."
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Number of replicas (ignored for DaemonSet)"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "default": "kentik/kagent",
          "description": "Container image repository"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"],
          "default": "IfNotPresent",
          "description": "Image pull policy"
        },
        "tag": {
          "type": "string",
          "default": "v5.0.1",
          "description": "Image tag (overrides Chart.AppVersion)"
        }
      }
    },
    "nameOverride": {
      "type": "string",
      "default": "",
      "description": "Override the chart name portion of generated resource names"
    },
    "fullnameOverride": {
      "type": "string",
      "default": "",
      "description": "Fully override the generated resource name"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {"type": "object"},
      "description": "Image pull secrets for private registries"
    },
    "kagent": {
      "type": "object",
      "required": ["companyId"],
      "properties": {
        "companyId": {
          "type": "string",
          "minLength": 1,
          "description": "Kentik company identifier for agent scoping (REQUIRED)"
        },
        "apiEndpoint": {
          "type": "string",
          "default": "grpc.api.kentik.com:443",
          "description": "Kentik API gRPC endpoint (maps to K_API_ROOT)"
        },
        "logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "default": "info",
          "description": "Logging verbosity level (K_LOG_LEVEL)"
        },
        "releaseChannel": {
          "type": "string",
          "enum": ["stable", "beta", "dev"],
          "default": "stable",
          "description": "Update channel for agent binary downloads"
        },
        "logDest": {
          "type": "string",
          "default": "stdout",
          "description": "Logging destination (stdout, stderr, discard, or file path)"
        },
        "healthCheck": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Enable health check HTTP server (K_HC_SERVER_ENABLED)"
            },
            "network": {
              "type": "string",
              "enum": ["tcp", "tcp4", "tcp6"],
              "default": "tcp4",
              "description": "Network protocol for health server (K_HC_SERVER_NETWORK)"
            },
            "address": {
              "type": "string",
              "default": "",
              "description": "Listen address for health server (K_HC_SERVER_ADDRESS). Empty renders as :<port>."
            },
            "port": {
              "type": "integer",
              "default": 8099,
              "description": "Health check server port used by container ports and services"
            }
          }
        },
        "diskReservation": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Enable disk space reservation (K_DISK_SPACE_RESERVATION_ENABLED)"
            },
            "initialSize": {
              "type": "string",
              "pattern": "^\\d+(MB|GB|TB)$",
              "default": "200MB",
              "description": "Amount of disk space to reserve (K_DISK_SPACE_RESERVATION_INITIAL_SIZE)"
            }
          }
        },
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean",
          "default": true,
          "description": "Create ServiceAccount for agent pods"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Annotations for ServiceAccount"
        },
        "name": {
          "type": "string",
          "description": "ServiceAccount name (generated if empty)"
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean",
          "default": false,
          "description": "Create RBAC resources (Role, RoleBinding)"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable NetworkPolicy for pod egress"
        },
        "egress": {
          "type": "array",
          "description": "Egress rules for NetworkPolicy"
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": {"type": "boolean", "default": true},
        "runAsUser": {"type": "integer", "default": 500},
        "fsGroup": {"type": "integer", "default": 500}
      }
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": {"type": "boolean", "default": false},
        "capabilities": {
          "type": "object",
          "properties": {
            "drop": {
              "type": "array",
              "items": {"type": "string"},
              "default": ["ALL"]
            },
            "add": {
              "type": "array",
              "items": {"type": "string"},
              "default": ["NET_RAW"]
            }
          }
        },
        "readOnlyRootFilesystem": {"type": "boolean", "default": false}
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {"type": "string", "default": "1"},
            "memory": {"type": "string", "default": "1024Mi"}
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {"type": "string", "default": "2"},
            "memory": {"type": "string", "default": "4096Mi"}
          }
        }
      }
    },
    "extraContainerPorts": {
      "type": "array",
      "description": "Additional container ports to expose on the kagent container",
      "items": {
        "type": "object",
        "required": ["name", "containerPort"],
        "properties": {
          "name": {"type": "string"},
          "containerPort": {"type": "integer"},
          "protocol": {
            "type": "string",
            "enum": ["TCP", "UDP", "SCTP"],
            "default": "TCP"
          }
        }
      }
    },
    "openshift": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable OpenShift-specific rendering behavior"
        },
        "restrictedSecurityContext": {
          "type": "boolean",
          "default": true,
          "description": "Omit fixed UID/GID fields and added Linux capabilities for compatibility with OpenShift restricted-v2 SCC"
        },
        "securityContextConstraints": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean",
              "default": false,
              "description": "Create a custom OpenShift SecurityContextConstraints resource"
            },
            "name": {
              "type": "string",
              "description": "Name of the SecurityContextConstraints resource (generated if empty)"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {"type": "string"},
              "description": "Annotations for the SecurityContextConstraints resource"
            },
            "allowHostDirVolumePlugin": {
              "type": "boolean",
              "default": false,
              "description": "Allow hostPath volumes in the custom SCC"
            },
            "allowHostNetwork": {
              "type": "boolean",
              "default": false,
              "description": "Allow hostNetwork in the custom SCC"
            },
            "allowPrivilegedContainer": {
              "type": "boolean",
              "default": false,
              "description": "Allow privileged containers in the custom SCC"
            },
            "allowedCapabilities": {
              "type": "array",
              "items": {"type": "string"},
              "default": ["NET_RAW"],
              "description": "Linux capabilities allowed by the custom SCC"
            }
          }
        }
      }
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable liveness probe (opt-in)"
        },
        "initialDelaySeconds": {"type": "integer", "default": 30},
        "periodSeconds": {"type": "integer", "default": 10},
        "timeoutSeconds": {"type": "integer", "default": 5},
        "failureThreshold": {"type": "integer", "default": 3}
      }
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable readiness probe (auto-enabled if healthCheck.enabled=true)"
        },
        "initialDelaySeconds": {"type": "integer", "default": 5},
        "periodSeconds": {"type": "integer", "default": 10},
        "timeoutSeconds": {"type": "integer", "default": 5},
        "failureThreshold": {"type": "integer", "default": 3}
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "description": "Node selector for pod scheduling"
    },
    "tolerations": {
      "type": "array",
      "description": "Tolerations for pod scheduling"
    },
    "affinity": {
      "type": "object",
      "description": "Affinity rules for pod scheduling"
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable persistent volumes"
        },
        "type": {
          "type": "string",
          "enum": ["pvc", "hostPath", "emptyDir"],
          "default": "pvc",
          "description": "Volume type: pvc (StatefulSet), hostPath or emptyDir (DaemonSet)"
        },
        "pvc": {
          "type": "object",
          "description": "PVC configuration (when type: pvc)",
          "properties": {
            "storageClass": {"type": "string", "default": "", "description": "Storage class name (empty = cluster default)"},
            "size": {"type": "string", "default": "10Gi"},
            "accessModes": {"type": "array", "items": {"type": "string"}, "default": ["ReadWriteOnce"]}
          }
        },
        "hostPath": {
          "type": "object",
          "description": "HostPath configuration (when type: hostPath)",
          "properties": {
            "path": {"type": "string", "default": "/var/lib/kagent/data"},
            "type": {"type": "string", "default": "DirectoryOrCreate"}
          }
        },
        "keypair": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "type": {
              "type": "string",
              "enum": ["secret", "pvc", "hostPath", "emptyDir"],
              "default": "secret",
              "description": "Keypair storage type"
            },
            "pvc": {
              "type": "object",
              "properties": {
                "storageClass": {"type": "string", "default": ""},
                "size": {"type": "string", "default": "100Mi"},
                "accessModes": {"type": "array", "items": {"type": "string"}, "default": ["ReadWriteOnce"]}
              }
            },
            "hostPath": {
              "type": "object",
              "properties": {
                "path": {"type": "string", "default": "/var/lib/kagent/keys"},
                "type": {"type": "string", "default": "DirectoryOrCreate"}
              }
            },
            "secret": {
              "type": "object",
              "description": "Secret configuration (when type: secret)",
              "properties": {
                "name": {"type": "string", "default": "", "description": "Secret name prefix (pod index appended automatically)"}
              }
            }
          }
        }
      }
    },
    "configmap": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable additional ConfigMap for advanced env var overrides"
        },
        "data": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Additional environment variables (for advanced users)"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Service resource"
        },
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"],
          "default": "ClusterIP"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Annotations for the Service resource"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Additional labels for the Service resource"
        },
        "externalTrafficPolicy": {
          "type": "string",
          "enum": ["", "Cluster", "Local"],
          "default": "",
          "description": "External traffic policy for NodePort or LoadBalancer services"
        },
        "loadBalancerIP": {
          "type": "string",
          "default": "",
          "description": "Static load balancer IP, when supported by the platform"
        },
        "loadBalancerSourceRanges": {
          "type": "array",
          "items": {"type": "string"},
          "description": "CIDR ranges allowed to access the load balancer"
        },
        "ports": {
          "type": "array",
          "description": "Service ports, including UDP intake ports and TCP health checks",
          "items": {
            "type": "object",
            "required": ["name", "port", "targetPort"],
            "properties": {
              "name": {"type": "string"},
              "port": {"type": "integer"},
              "targetPort": {
                "oneOf": [
                  {"type": "string"},
                  {"type": "integer"}
                ]
              },
              "protocol": {
                "type": "string",
                "enum": ["TCP", "UDP", "SCTP"],
                "default": "TCP"
              },
              "nodePort": {"type": "integer"},
              "appProtocol": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
